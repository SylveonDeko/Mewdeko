# Discord OAuth application settings
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_SCOPES="identify guilds"
DISCORD_REDIRECT_URI="http://localhost:3000/api/discord/callback"
DISCORD_API_URL="https://discord.com/api"

# Generate with: openssl rand -base64 32
COOKIE_ENCRYPTION_PASSWORD=""

# Must match ApiKey and JwtSecret in credentials.json.
PUBLIC_MEWDEKO_API_URL="http://mewdeko:5001/botapi"
MEWDEKO_API_KEY=""
BOT_JWT_SECRET=""

# The Compose Redis service and the first ten characters of the Discord bot token.
USE_REDIS=true
REDIS_URL="redis"
REDIS_KEY=""

NODE_ENV=production
